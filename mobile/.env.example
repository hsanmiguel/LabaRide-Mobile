# This default works for web on this computer and Expo Go in native LAN development.
# Expo Go replaces localhost with Expo's current LAN host automatically.
# For a manual phone URL, use your computer's current LAN address on port 5001.
# Android emulator: http://10.0.2.2:5001
# Web on this computer: http://localhost:5001
# In native LAN development, a missing/localhost URL uses Expo's LAN host.
# After editing .env, fully close/reopen Expo Go. Start with npm run start:phone.
# An Expo tunnel does not expose port 5001; use a reachable backend URL with it.
EXPO_PUBLIC_API_URL=http://localhost:5001
