{
  "expo": {
    "name": "LabaRide",
    "slug": "labaride-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.labaride.mobile"
    },
    "android": {
      "package": "com.labaride.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "scheme": "labaride",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your shop, rider requirements, or laundry scale measurements.",
          "cameraPermission": "Allow LabaRide to take a photo of the laundry and scale reading for the customer.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow LabaRide to share your position with customers during active jobs while the app is open.",
          "locationAlwaysAndWhenInUsePermission": "Allow LabaRide to use your location for pickup and delivery routing."
        }
      ],
      "@react-native-community/datetimepicker",
      "@rnmapbox/maps"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "80c18a2f-970c-4720-bc7f-e6fba1b0d4d0"
      }
    },
    "owner": "codexlangmalakas5"
  }
}
