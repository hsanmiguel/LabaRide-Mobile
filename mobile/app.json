{
  "expo": {
    "name": "LabaRide",
    "slug": "labaride-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "scheme": "labaride",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-image-picker", { "photosPermission": "Choose a photo to display your laundry shop to customers.", "cameraPermission": false, "microphonePermission": false }],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow LabaRide to use your location for pickup and delivery routing."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
