# Use your computer's LAN address when opening the app on a physical phone.
# Android emulator: http://10.0.2.2:5000
# Web on this computer: http://localhost:5000
# In native LAN development, a missing/localhost URL uses Expo's LAN host.
# After editing .env, fully close/reopen Expo Go. Start with npm run start:phone.
# An Expo tunnel does not expose port 5000; use a reachable backend URL with it.
EXPO_PUBLIC_API_URL=http://localhost:5000
